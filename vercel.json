{
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/departments", "dest": "/departments/index.html" },
    { "src": "/departments/(?<slug>[^/]+)", "dest": "/departments/department.html?slug=$slug" },
    { "src": "/courses/(?<slug>[^/]+)", "dest": "/course.html?slug=$slug" },
    { "src": "/admin", "dest": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
