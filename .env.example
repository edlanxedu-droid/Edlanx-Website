# Copy to .env.local for local `vercel dev`, and set the same keys
# in Vercel Project Settings -> Environment Variables for production.
# Never commit the real values.

# ---- PostgreSQL ----
# Standard connection string. On Railway: add a Postgres plugin to the same
# project, then reference it as ${{ Postgres.DATABASE_URL }} in this service's
# variables — Railway fills in the real value automatically.
DATABASE_URL=postgres://user:password@your-host:5432/edlanx
# "off" = no SSL, "strict" = verify a real CA cert, anything else = SSL without
# cert verification. Use "off" for Railway's Postgres plugin (private network,
# no SSL needed between services in the same project).
DATABASE_SSL=off

# Railway sets this automatically — do not set it yourself.
# PORT=

# ---- Admin panel sessions ----
# Any long random string. Rotating it logs every admin out.
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Brevo / lead-email fallback ----
# These are only used until the equivalent value is set from the admin
# panel (Settings page) — the DB value always wins once configured there.
BREVO_API_KEY=your-brevo-api-key
NOTIFY_EMAIL=admissions@edlanx.com
NOTIFY_FROM_EMAIL=no-reply@edlanx.com
NOTIFY_FROM_NAME=Edlanx Website
SITE_URL=https://edlanx.com
